# Host port mapped to the container's internal port 3000
HOST_PORT=3000

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
# Public URL of the app — must match the host:port you access it on
# (docker-compose sets AUTH_URL=http://localhost:${HOST_PORT} automatically)
AUTH_URL=http://localhost:3000

# BUCC API Gateway direct access (status page) — credentials from the Apps table
API_URL=https://api.mholdingsgroup.my
API_APP_ID=your_app_id
API_APP_KEY=your_app_key
API_APP_SECRET=your_app_secret
